!/09_phase7_risk_of_bias/results/**
!/09_phase7_risk_of_bias/logs/**
# model results and run logs
!/10_phase8_analysis/results/**
# tables, figures and supplementary material (manuscript drafts are not included)
!/12_documents/tables/**
!/12_documents/figures/**
!/12_documents/supplementary/**
# inputs of the analysis chain and decision records (team decision 2026-10-28): screening and verification
# decisions, verification and risk-of-bias workbooks, applicability matrix, pre-specified rules and decisions,
# search strategies, licence and citation files
!/LICENSE
!/CITATION.cff
!/01_search/strategies/**
!/01_search/prisma_s_log.csv
