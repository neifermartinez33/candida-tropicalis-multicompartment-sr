# third-party records and abstracts, and a working log not read by any script, stay out
*.ris
/04_phase2_calibration/results/calibration_CAL1_discrepancies.csv
/04_phase2_calibration/results/calibration_CAL1_consensus.xlsx
/04_phase2_calibration/results/calibration_CAL1_consensus_adjusted.xlsx
